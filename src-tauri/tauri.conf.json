{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QCM",
  "version": "2.0.0",
  "identifier": "com.devtounsi.qcm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QCM",
        "width": 440,
        "height": 340,
        "minWidth": 360,
        "minHeight": 230,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
